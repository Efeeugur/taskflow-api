                  "pm.test(\"Yanıt formatı doğru\", () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const t = pm.response.json().data;",
                  "pm.test(\"Alanlar güncellenir\", () => { pm.expect(t.status).to.eql(\"in-progress\"); pm.expect(t.priority).to.eql(\"medium\"); });",
                  "pm.test(\"updatedAt createdAt'tan farklı\", () => pm.expect(t.updatedAt).to.not.eql(t.createdAt));"
