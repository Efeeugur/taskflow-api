  "item": [
    {
      "name": "01 - CRUD (zorunlu)",
      "item": [
        {
          "name": "1. Görev ekle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Yeni görev oluşturur. Oluşan id, sonraki istekler için taskId değişkenine kaydedilir.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kullanıcı girişi endpoint'i\",\n  \"description\": \"JWT ile backend girişi\",\n  \"priority\": \"high\",\n  \"assignee\": \"Efe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Yanıt formatı doğru\", () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const t = pm.response.json().data;",
                  "pm.test(\"Yeni görev todo durumunda başlar\", () => pm.expect(t.status).to.eql(\"todo\"));",
                  "pm.test(\"id ve zaman damgaları atanır\", () => { pm.expect(t.id).to.be.a(\"number\"); pm.expect(t.createdAt).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"taskId\", t.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Görevleri listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
