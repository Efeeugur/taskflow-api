                  "pm.test(\"Liste dizi döner\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));",
                  "pm.test(\"Eklenen görev listede\", () => pm.expect(pm.response.json().data.map(t => t.id)).to.include(pm.collectionVariables.get(\"taskId\")));"
                ]
